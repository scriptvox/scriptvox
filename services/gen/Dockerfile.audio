# scriptvox-gen audio: Chatterbox Multilingual TTS (MIT), faster-whisper STT (MIT), Demucs stems (MIT). chatterbox 0.1.7 pins torch 2.6,
# so this image has its own base. MMAudio (code MIT, weights CC BY-NC, testing only) is installed without its own
# dependency list (it pins numpy and gradio we do not need); the libraries it imports are listed here (av and
# einops come with chatterbox). Weights come from the registry (oras) onto the node NVMe, not in the image.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
RUN pip install --no-cache-dir chatterbox-tts==0.1.7 faster-whisper==1.2.1 \
 && python -c "import urllib.request,tarfile,io,hashlib; d=urllib.request.urlopen('https://github.com/oras-project/oras/releases/download/v1.2.3/oras_1.2.3_linux_amd64.tar.gz').read(); assert hashlib.sha256(d).hexdigest()=='b4efc97a91f471f323f193ea4b4d63d8ff443ca3aab514151a30751330852827', 'oras tarball sha256'; tarfile.open(fileobj=io.BytesIO(d)).extract('oras','/usr/local/bin')" \
 && pip install --no-cache-dir open_clip_torch==2.32.0 timm==1.0.15 torchdiffeq==0.2.5 \
    tensordict==0.7.2 hydra-core==1.3.2 colorlog==6.9.0 nitrous-ema==0.0.1 python-dotenv==1.1.0 \
    demucs==4.0.1 \
 && pip install --no-cache-dir --no-deps https://github.com/hkchengrex/MMAudio/archive/974010a026c731054592d8f777218bd9d85a6c24.tar.gz \
 && python -c "import chatterbox.mtl_tts, faster_whisper, mmaudio.eval_utils, mmaudio.model.networks, demucs.apply; print('imports ok')"
COPY server.py engines_audio.py /app/
ENV PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 ENGINES=audio PYTHONPATH=/app
EXPOSE 8080
CMD ["python", "/app/server.py"]
